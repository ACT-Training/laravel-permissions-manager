{
    "name": "act-training/laravel-permissions-manager",
    "description": "A comprehensive roles and permissions management UI for Laravel applications, built on Spatie Laravel Permission with Livewire and FluxUI Pro.",
    "keywords": [
        "laravel",
        "permissions",
        "roles",
        "spatie",
        "livewire",
        "flux",
        "acl",
        "rbac"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Simon Barrett",
            "email": "simon@acttraining.org.uk"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "spatie/laravel-permission": "^6.0",
        "livewire/livewire": "^3.0|^4.0",
        "act-training/query-builder": "^2.3|^3.0"
    },
    "require-dev": {
        "livewire/flux": "^2.21",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "spatie/enum": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "ACTTraining\\PermissionsManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ACTTraining\\PermissionsManager\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ACTTraining\\PermissionsManager\\PermissionsManagerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
